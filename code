<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>19GRAMS Cafe — Marrakech</title>

<style>
:root{
  --cream:#f6efe6;
  --white:#fffaf3;
  --brown:#24150f;
  --brown2:#4a2d20;
  --gold:#b88a5a;
  --muted:#6f5848;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:Arial,Helvetica,sans-serif;background:var(--cream);color:var(--brown)}
a{text-decoration:none;color:inherit}

.nav{position:sticky;top:0;z-index:100;background:rgba(246,239,230,.94);backdrop-filter:blur(14px);border-bottom:1px solid rgba(36,21,15,.1)}
.nav-inner{max-width:1200px;margin:auto;padding:22px 24px;display:flex;justify-content:space-between;align-items:center}
.logo{font-family:Georgia,serif;font-size:22px;letter-spacing:.25em}
.links{display:flex;gap:22px;align-items:center}
.links a,.lang{font-size:12px;text-transform:uppercase;letter-spacing:.16em;color:var(--muted)}
.lang{border:1px solid rgba(36,21,15,.18);border-radius:30px;padding:10px 16px;background:white;cursor:pointer}

.hero{max-width:1200px;margin:auto;padding:95px 24px;display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:center}
.eyebrow{text-transform:uppercase;letter-spacing:.28em;font-size:12px;color:var(--gold);margin-bottom:20px}
h1{font-family:Georgia,serif;font-size:clamp(58px,8vw,108px);line-height:.92;font-weight:400;letter-spacing:-.06em}
.lead{font-size:19px;line-height:1.8;color:var(--muted);margin-top:28px;max-width:640px}
.actions{display:flex;gap:14px;margin-top:34px;flex-wrap:wrap}
.btn{display:inline-block;border-radius:999px;padding:15px 26px;border:1px solid rgba(36,21,15,.18);background:white;text-transform:uppercase;letter-spacing:.16em;font-size:12px}
.btn.dark{background:var(--brown);color:white;border-color:var(--brown)}

.hero-card{min-height:610px;border-radius:52px;padding:18px;background:linear-gradient(135deg,#fffaf3,#d7b99a,#3a2117);box-shadow:0 35px 90px rgba(36,21,15,.18)}
.glass{height:100%;border-radius:38px;background:rgba(255,255,255,.3);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.55);padding:36px;display:flex;flex-direction:column;justify-content:space-between}
.signature{font-family:Georgia,serif;font-size:54px;line-height:1;margin-top:14px}
.cup{width:230px;height:230px;margin:50px auto;border-radius:50%;background:radial-gradient(circle at 50% 42%,#f3d8ad 0 22%,#6e3f2a 23% 42%,#2b1811 43% 62%,#fffaf3 63%);box-shadow:0 25px 55px rgba(36,21,15,.2)}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.stat{background:rgba(255,255,255,.58);border-radius:24px;padding:18px;color:#5b473d;font-size:14px}

section{padding:100px 24px}
.wrap{max-width:1200px;margin:auto}
.section-head{display:flex;justify-content:space-between;gap:40px;margin-bottom:44px;align-items:end}
h2{font-family:Georgia,serif;font-size:clamp(46px,6vw,82px);line-height:.96;font-weight:400;letter-spacing:-.05em}
.intro{max-width:500px;line-height:1.7;color:var(--muted)}

.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{background:white;border-radius:34px;padding:34px;box-shadow:0 20px 55px rgba(36,21,15,.06)}
.card h3{font-family:Georgia,serif;font-size:30px;margin-bottom:14px}
.card p{line-height:1.75;color:var(--muted)}

.panel{background:rgba(255,255,255,.65);border-radius:44px;padding:34px;box-shadow:0 28px 70px rgba(36,21,15,.08)}
.panel-title{font-family:Georgia,serif;font-size:34px;margin-bottom:24px}
.menu-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.item{background:var(--white);border-radius:28px;padding:24px;border:1px solid rgba(36,21,15,.08)}
.row{display:flex;justify-content:space-between;gap:16px}
.item h3{font-size:21px}
.price{color:var(--gold);white-space:nowrap}
.desc{margin-top:12px;color:var(--muted);line-height:1.6;font-size:14px}

.dark-panel{background:var(--brown);color:white;border-radius:44px;padding:34px;margin-top:28px}
.drink-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}
.drink{background:rgba(255,255,255,.08);border-radius:18px;padding:16px;display:flex;justify-content:space-between;gap:12px}

.story{background:#efe2d4}
.story-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.visual-shop{min-height:500px;border-radius:48px;background:linear-gradient(180deg,#f7efe4,#d4b79c);padding:30px}
.counter{height:100%;border-radius:34px;background:linear-gradient(180deg,#fbf5ec 0 40%,#ffffff 40% 52%,#8b5a42 52%);position:relative;overflow:hidden}
.counter:after{content:"19GRAMS";position:absolute;right:8%;top:8%;font-family:Georgia,serif;font-size:32px;color:#b88745;letter-spacing:.12em}

.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:42px}
.review{background:rgba(255,255,255,.64);border-radius:32px;padding:30px}
.stars{color:#b88745;font-size:24px;margin-bottom:14px}

.instagram{background:var(--brown);color:white;text-align:center}
.instagram p{max-width:700px;margin:22px auto 34px;color:rgba(255,255,255,.75);line-height:1.8}

.contact-card{background:var(--brown);color:white;border-radius:50px;padding:50px;display:grid;grid-template-columns:1fr 1fr;gap:50px}
.contact-card p{color:rgba(255,255,255,.78);line-height:1.7;margin-top:10px}

.footer{text-align:center;padding:34px;color:var(--muted)}

@media(max-width:900px){
  .hero,.story-grid,.contact-card{grid-template-columns:1fr}
  .menu-grid,.drink-grid,.cards,.review-grid{grid-template-columns:1fr}
  .links a{display:none}
}
</style>
</head>

<body>

<nav class="nav">
  <div class="nav-inner">
    <div class="logo">19GRAMS</div>
    <div class="links">
      <a href="#menu" data-fr="Menu" data-en="Menu">Menu</a>
      <a href="#maison" data-fr="Maison" data-en="House">Maison</a>
      <a href="#about" data-fr="À propos" data-en="About">À propos</a>
      <a href="#instagram">Instagram</a>
      <a href="#contact">Contact</a>
      <button class="lang" onclick="toggleLang()" id="langBtn">EN</button>
    </div>
  </div>
</nav>

<main>

<section class="hero">
  <div>
    <div class="eyebrow" data-fr="Specialty coffee · Marrakech" data-en="Specialty coffee · Marrakech">Specialty coffee · Marrakech</div>
    <h1 data-fr="Café de spécialité, ambiance cozy, moments simples." data-en="Specialty coffee, cozy atmosphere, simple moments.">Café de spécialité, ambiance cozy, moments simples.</h1>
    <p class="lead" data-fr="19GRAMS Cafe est pensé comme une pause chaleureuse à Marrakech : cafés travaillés, boissons fraîches et petites gourmandises dans un décor simple et accueillant." data-en="19GRAMS Cafe is designed as a warm break in Marrakech: crafted coffees, fresh drinks and sweet bites in a simple, welcoming setting.">19GRAMS Cafe est pensé comme une pause chaleureuse à Marrakech : cafés travaillés, boissons fraîches et petites gourmandises dans un décor simple et accueillant.</p>
    <div class="actions">
      <a class="btn dark" href="#menu" data-fr="Voir le menu" data-en="View menu">Voir le menu</a>
      <a class="btn" href="https://www.instagram.com/19gramscafe/" target="_blank">Instagram</a>
    </div>
  </div>

  <div class="hero-card">
    <div class="glass">
      <div>
        <div class="eyebrow">Signature</div>
        <div class="signature">19GRAMS Latte</div>
        <div class="cup"></div>
      </div>
      <div class="stats">
        <div class="stat" data-fr="Café de spécialité" data-en="Specialty coffee">Café de spécialité</div>
        <div class="stat">Gueliz · Marrakech</div>
        <div class="stat" data-fr="Ambiance cozy" data-en="Cozy atmosphere">Ambiance cozy</div>
        <div class="stat" data-fr="Menu démo" data-en="Demo menu">Menu démo</div>
      </div>
    </div>
  </div>
</section>

<section id="maison">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow" data-fr="La maison" data-en="The house">La maison</div>
        <h2 data-fr="Un café calme, moderne et chaleureux." data-en="A calm, modern and warm café.">Un café calme, moderne et chaleureux.</h2>
      </div>
      <p class="intro" data-fr="Un espace pensé pour les pauses café, les rendez-vous simples, le travail léger et les moments tranquilles." data-en="A space made for coffee breaks, simple meetups, light work and quiet moments.">Un espace pensé pour les pauses café, les rendez-vous simples, le travail léger et les moments tranquilles.</p>
    </div>

    <div class="cards">
      <div class="card"><h3 data-fr="Café travaillé" data-en="Crafted coffee">Café travaillé</h3><p data-fr="Une carte centrée sur le café, les boissons fraîches et les recettes simples mais bien présentées." data-en="A menu focused on coffee, fresh drinks and simple recipes with a clean presentation.">Une carte centrée sur le café, les boissons fraîches et les recettes simples mais bien présentées.</p></div>
      <div class="card"><h3 data-fr="Vibe cozy" data-en="Cozy vibe">Vibe cozy</h3><p data-fr="Un lieu qui donne envie de rester : lumière douce, couleurs chaudes et ambiance calme." data-en="A place that makes people want to stay: soft light, warm colors and a calm atmosphere.">Un lieu qui donne envie de rester : lumière douce, couleurs chaudes et ambiance calme.</p></div>
      <div class="card"><h3 data-fr="Marrakech moderne" data-en="Modern Marrakech">Marrakech moderne</h3><p data-fr="Une adresse simple, jeune et premium dans l’esprit des cafés modernes de Gueliz." data-en="A simple, young and premium address in the spirit of modern cafés in Gueliz.">Une adresse simple, jeune et premium dans l’esprit des cafés modernes de Gueliz.</p></div>
    </div>
  </div>
</section>

<section id="menu">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">Menu</div>
        <h2 data-fr="Sélection maison" data-en="House selection">Sélection maison</h2>
      </div>
      <p class="intro" data-fr="Menu démo à remplacer par la vraie carte : cafés, boissons froides, snacks et pâtisseries." data-en="Demo menu to replace with the real menu: coffees, cold drinks, snacks and pastries.">Menu démo à remplacer par la vraie carte : cafés, boissons froides, snacks et pâtisseries.</p>
    </div>

    <div class="panel">
      <h3 class="panel-title" data-fr="Cafés chauds" data-en="Hot coffees">Cafés chauds</h3>
      <div class="menu-grid">
        <div class="item"><div class="row"><h3>Espresso</h3><span class="price">25 DH</span></div><p class="desc" data-fr="Court, intense et équilibré." data-en="Short, intense and balanced.">Court, intense et équilibré.</p></div>
        <div class="item"><div class="row"><h3>Cappuccino</h3><span class="price">35 DH</span></div><p class="desc" data-fr="Espresso, lait mousseux et texture douce." data-en="Espresso, foamed milk and smooth texture.">Espresso, lait mousseux et texture douce.</p></div>
        <div class="item"><div class="row"><h3>Latte</h3><span class="price">38 DH</span></div><p class="desc" data-fr="Café doux avec une belle longueur en bouche." data-en="Smooth coffee with a soft finish.">Café doux avec une belle longueur en bouche.</p></div>
        <div class="item"><div class="row"><h3>Mocha</h3><span class="price">42 DH</span></div><p class="desc" data-fr="Café, chocolat et lait chaud." data-en="Coffee, chocolate and warm milk.">Café, chocolat et lait chaud.</p></div>
      </div>
    </div>

    <div class="dark-panel">
      <h3 class="panel-title" data-fr="Boissons froides" data-en="Cold drinks">Boissons froides</h3>
      <div class="drink-grid">
        <div class="drink"><span>Iced Latte</span><span>45 DH</span></div>
        <div class="drink"><span>Cold Brew</span><span>45 DH</span></div>
        <div class="drink"><span>Matcha Latte</span><span>45 DH</span></div>
        <div class="drink"><span>Iced Mocha</span><span>48 DH</span></div>
        <div class="drink"><span>Fresh Juice</span><span>35 DH</span></div>
        <div class="drink"><span>Signature Drink</span><span>55 DH</span></div>
      </div>
    </div>

    <div class="dark-panel">
      <h3 class="panel-title" data-fr="Gourmandises" data-en="Sweet bites">Gourmandises</h3>
      <div class="drink-grid">
        <div class="drink"><span>Cookie</span><span>28 DH</span></div>
        <div class="drink"><span>Brownie</span><span>35 DH</span></div>
        <div class="drink"><span>Banana Bread</span><span>35 DH</span></div>
        <div class="drink"><span>Croissant</span><span>25 DH</span></div>
        <div class="drink"><span>Cheesecake</span><span>45 DH</span></div>
        <div class="drink"><span>Granola Bowl</span><span>55 DH</span></div>
      </div>
    </div>
  </div>
</section>

<section class="story" id="about">
  <div class="wrap story-grid">
    <div class="visual-shop"><div class="counter"></div></div>
    <div>
      <div class="eyebrow" data-fr="À propos" data-en="About">À propos</div>
      <h2 data-fr="Une marque simple, locale et premium." data-en="A simple, local and premium brand.">Une marque simple, locale et premium.</h2>
      <p class="lead" data-fr="Le site met en avant l’essentiel : l’ambiance, le café, le menu et le lien Instagram. Pas besoin de surcharger avec des photos si Instagram joue déjà ce rôle." data-en="The website focuses on what matters: atmosphere, coffee, menu and Instagram. No need to overload it with photos if Instagram already plays that role.">Le site met en avant l’essentiel : l’ambiance, le café, le menu et le lien Instagram. Pas besoin de surcharger avec des photos si Instagram joue déjà ce rôle.</p>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow" data-fr="Pourquoi venir" data-en="Why visit">Pourquoi venir</div>
        <h2 data-fr="Le bon spot pour une vraie pause." data-en="The right spot for a real break.">Le bon spot pour une vraie pause.</h2>
      </div>
    </div>

    <div class="review-grid">
      <div class="review"><div class="stars">★★★★★</div><h3 data-fr="Café" data-en="Coffee">Café</h3><p data-fr="Un menu clair et moderne autour du café de spécialité." data-en="A clear and modern menu around specialty coffee.">Un menu clair et moderne autour du café de spécialité.</p></div>
      <div class="review"><div class="stars">★★★★★</div><h3 data-fr="Ambiance" data-en="Atmosphere">Ambiance</h3><p data-fr="Cozy, calme, parfait pour travailler ou discuter." data-en="Cozy, calm, perfect for working or talking.">Cozy, calme, parfait pour travailler ou discuter.</p></div>
      <div class="review"><div class="stars">★★★★★</div><h3 data-fr="Localisation" data-en="Location">Localisation</h3><p data-fr="Une adresse simple à partager avec les clients et les touristes." data-en="A simple address to share with customers and tourists.">Une adresse simple à partager avec les clients et les touristes.</p></div>
    </div>
  </div>
</section>

<section class="instagram" id="instagram">
  <div class="wrap">
    <div class="eyebrow">Instagram</div>
    <h2 data-fr="Découvrez l’ambiance en images." data-en="Discover the atmosphere in pictures.">Découvrez l’ambiance en images.</h2>
    <p data-fr="Pour voir les cafés, les boissons, les plats et l’atmosphère du lieu, rendez-vous directement sur Instagram." data-en="To see the coffees, drinks, food and atmosphere, visit Instagram directly.">Pour voir les cafés, les boissons, les plats et l’atmosphère du lieu, rendez-vous directement sur Instagram.</p>
    <a class="btn" href="https://www.instagram.com/19gramscafe/" target="_blank">@19gramscafe</a>
  </div>
</section>

<section id="contact">
  <div class="wrap contact-card">
    <div>
      <div class="eyebrow" style="color:rgba(255,255,255,.6)">Contact</div>
      <h2 data-fr="Passez prendre un café." data-en="Come for a coffee.">Passez prendre un café.</h2>
    </div>
    <div>
      <p>📍 2 Rue Sourya, Gueliz, Marrakech</p>
      <p data-fr="🕒 Tous les jours · 8h00 – 20h30" data-en="🕒 Open daily · 8:00am – 8:30pm">🕒 Tous les jours · 8h00 – 20h30</p>
      <p>📸 @19gramscafe</p>
      <div class="actions">
        <a class="btn" href="https://www.instagram.com/19gramscafe/" target="_blank">Instagram</a>
      </div>
    </div>
  </div>
</section>

</main>

<footer class="footer">19GRAMS Cafe © 2026 · Concept website preview</footer>

<script>
let lang="fr";
function toggleLang(){
  lang = lang === "fr" ? "en" : "fr";
  document.querySelectorAll("[data-fr]").forEach(el=>{
    el.textContent = el.getAttribute("data-" + lang);
  });
  document.getElementById("langBtn").textContent = lang === "fr" ? "EN" : "FR";
  document.documentElement.lang = lang;
}
</script>

</body>
</html>
